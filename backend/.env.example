# Lenny Growth Assistant - Backend Configuration
# Copy to .env and fill in your values. NEVER commit .env.

APP_NAME=Lenny Growth Assistant
ENVIRONMENT=development
LOG_LEVEL=INFO

# Default LLM provider: ollama | groq | gemini | mock
LLM_PROVIDER=ollama

# Ollama (local, offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq (ultra-fast cloud inference)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Database & vector store (defaults are fine for local use)
# DATABASE_URL=sqlite:///lenny_growth.db
# CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=lenny_growth_transcripts

# Retrieval tuning
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=4
# Refusal gate: chunks must clear this bge-cosine similarity (0-1) or the
# assistant refuses to answer. Calibrated for the default embedding model.
RELEVANCE_CUTOFF=0.62
# Embedding + reranking stack (sentence-transformers). Changing EMBEDDING_MODEL
# auto-reindexes the vector store on next use; recalibrate RELEVANCE_CUTOFF.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true
RERANK_CANDIDATES=12
